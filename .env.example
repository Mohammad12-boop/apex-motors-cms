# Copy to .env.local. Use only the publishable/anon key, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Explicit opt-in for the local browser demo on a static preview build.
# Demo edits and submissions stay in this browser and are not a hosted database.
VITE_ENABLE_DEMO=false
